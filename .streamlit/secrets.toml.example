# Copy this file to .streamlit/secrets.toml (local dev) and fill in real values,
# OR set the same keys as environment variables / platform "secrets" when deploying.
# .streamlit/secrets.toml itself is gitignored — never commit real keys.

# Required
GROQ_API_KEY = "your-groq-api-key"

# Optional — each feature degrades gracefully (shown as disabled in the sidebar) if left blank.
OPENWEATHER_API_KEY = ""
GMAIL_ADDRESS = ""
GMAIL_APP_PASSWORD = ""
NEWS_API_KEY = ""
TAVILY_API_KEY = ""
GOOGLE_CALENDAR_CREDENTIALS_PATH = ""
GOOGLE_CALENDAR_TOKEN_PATH = "token.json"
